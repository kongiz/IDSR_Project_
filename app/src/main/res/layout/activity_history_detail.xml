<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/idsr_background"
    android:padding="16dp"
    android:fillViewport="true"
    tools:context=".activities.HistoryDetail_Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">


        <ImageButton
            android:id="@+id/btnBackDetail"
            android:layout_width="40dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_btn"
            app:tint="@color/idsr_on_surface"
            android:contentDescription="Back" />


        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/splash11"
            android:contentDescription="App Logo"
            android:scaleType="fitCenter" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/idsr_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtFacility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Facility Name"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/idsr_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/txtRegion"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtDistrict"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtEpiweek"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtDateFrom"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtDateTo"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/idsr_gray"
                    android:layout_marginVertical="8dp" />

                <TextView
                    android:id="@+id/txtTotalU5Male"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtTotalU5Female"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtTotalA5Male"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtTotalA5Female"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtGrandTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grand Total:"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/idsr_on_surface"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/idsr_gray"
                    android:layout_marginVertical="8dp" />

                <TextView
                    android:id="@+id/txtOfficerName"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtDesignation"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>

                <TextView
                    android:id="@+id/txtComment"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtCreatedAt"
                    style="@style/HistoryDetailText"
                    android:textColor="@color/idsr_on_surface"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/txtDiseasesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diseases Reported"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/idsr_primary"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/idsr_surface"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDiseases"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"
                    android:nestedScrollingEnabled="true" />

                <TextView
                    android:id="@+id/txtDiseasesEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No disease data available"
                    android:textAlignment="center"
                    android:textColor="@color/idsr_gray"
                    android:textSize="15sp"
                    android:padding="12dp"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Report"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:paddingVertical="14dp"
            app:cornerRadius="12dp"
            app:icon="@drawable/baseline_edit_24"
            app:iconGravity="start"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Report"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/idsr_on_primary"
            android:paddingVertical="14dp"
            android:visibility="gone"
            app:backgroundTint="@color/idsr_secondary"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_share"
            app:iconTint="@color/idsr_on_primary"
            app:iconGravity="start"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go Back"
            android:textAllCaps="false"
            android:textColor="@color/idsr_on_primary"
            app:backgroundTint="@color/idsr_primary"
            app:cornerRadius="12dp"
            android:paddingVertical="14dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
