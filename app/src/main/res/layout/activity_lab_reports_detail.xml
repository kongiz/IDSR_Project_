<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnBackLabReportDetail"
            android:layout_width="40dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_btn"
            app:tint="@color/black"
            android:contentDescription="Back" />


        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/splash11"
            android:scaleType="fitCenter" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Lab Information"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView android:text="Lab Name" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/txtLabName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="Date Lab Received" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/txtDateLabReceived"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="Specimen Condition" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/txtSpecimenCondition"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="Tests Performed" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/txtTestTypes"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>



        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Final Laboratory Result"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView android:text="Final Result" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView android:id="@+id/txtFinalResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="Lab Result Image" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/imgLabResult"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="8dp"
                    android:background="#EEEEEE" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>



        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Administrative Information"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView android:text="Date Lab Sent to District" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView android:id="@+id/txtDateSentDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="Date District Received Result" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView android:id="@+id/txtDateDistrictReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="Region" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView android:id="@+id/txtRegion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="District" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView android:id="@+id/txtDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:text="Created At" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <TextView android:id="@+id/txtCreatedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnBackLabReportReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go Back"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
